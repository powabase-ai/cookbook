# Recipe 02 — HITL Invoice Extraction Queue
# Recipe-root credentials (seed scripts + psql)
#
# Copy to .env.local and fill in values from Studio → Project Connect for
# your cookbook-02 project. .env.local is gitignored.
#
# These power:
#   • seed-agents.ts, seed-vendor-history.ts, upload-invoices.ts,
#     trigger-extractions.ts, seed.ts, dogfood.ts
#   • psql for schema + policies application
#
# The Vite app (under code/) has its own separate .env.example for runtime.

# ── From Studio → Project Connect → API ─────────────────────────────────────
VITE_POWABASE_URL=
POWABASE_SERVICE_ROLE_KEY=

# ── From Studio → Project Connect → Connection Strings → Direct / PSQL ──────
DATABASE_URI=
