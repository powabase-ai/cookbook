# Recipe 01 — Multi-agent customer support team
# Recipe-root credentials (seed script + psql)
#
# Copy to .env.local and fill in values from Studio → Project Connect
# for your cookbook-01 project.
#
# .env.local is gitignored — never commit real credentials.
#
# These credentials power:
#   • seed-agents.ts   — creates 3 KBs + 3 agents + 1 Supervisor orchestration
#   • psql             — applies schema.sql and policies.sql
#
# The Vite app (under code/) uses its own separate .env.example for runtime.

# ── From Studio → Project Connect → API ─────────────────────────────────────
VITE_POWABASE_URL=
POWABASE_SERVICE_ROLE_KEY=

# ── From Studio → Project Connect → Connection Strings → Direct / PSQL ──────
DATABASE_URI=
