# Recipe 01 — Multi-agent customer support team
# Runtime credentials (read by the Vite app at build time)
#
# Copy to .env.local and fill in values from Studio → Project Connect → API.
# .env.local is gitignored — never commit real credentials.
#
# Different set from the recipe-root .env.local (which has seed + psql creds).

# Project API URL, e.g. https://<your-ref>.p.powabase.ai
VITE_POWABASE_URL=

# Anon key — safe for the browser, gated by RLS
VITE_POWABASE_ANON_KEY=

# Orchestration ID — printed by `npm run seed` at the recipe root
VITE_POWABASE_ORCHESTRATION_ID=
